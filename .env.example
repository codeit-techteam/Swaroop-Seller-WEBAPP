# PolyStoreX Seller WebApp — environment TEMPLATE (safe to commit)
#
# Local:  cp .env.example .env.local
# Production: set the same keys in Vercel / host secrets.
# Do not put real keys, tokens, or passwords in this file.

NEXT_PUBLIC_APP_NAME=PolyStoreX Seller
NEXT_PUBLIC_APP_URL=http://localhost:3003

NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://admin.polystorex.com

# Browser Maps key only (HTTP-referrer restricted). Never use a server Maps key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Must stay false in production
NEXT_PUBLIC_DEMO_OTP=false
